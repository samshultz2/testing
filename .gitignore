# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# Flask / instance data — the live database stays local, never in version
# control, so each install keeps its own data and code pulls never conflict.
# (init_db recreates schema + seed data on first run.)
instance/*.db
instance/*.db.backup
instance/*.sqlite
instance/backups/
instance/.secret_key
instance/*.jsonl
/school.db

# Uploads (user-generated)
uploads/*
!uploads/.gitkeep

# Backups & scratch files
*.bak
*.v25.bak
*.tmp
*.orig

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local environment overrides
.env

# CBT question image uploads (user content)
static/uploads/
loadtest/students.csv

# React frontend build deps (the built bundle in static/js/react/ IS committed)
frontend/node_modules/
