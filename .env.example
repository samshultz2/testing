# PosyHub environment configuration
# Copy this file to ".env" (same folder as app.py) and edit the values.
# Real OS environment variables override anything set here.
# NEVER commit your real .env — it's already in .gitignore.

# --- Security (set these in production) ---
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left unset, a random key is generated and stored in instance/.secret_key.
SECRET_KEY=

# Password for the legacy shared "Admin" login.
ADMIN_PASSWORD=change-this-password

# Set to 0 to disable the shared-password login once real user accounts exist.
ENABLE_LEGACY_LOGIN=1

# --- Login throttling ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Cookies ---
# Set to 1 only when serving over HTTPS (so the session cookie is HTTPS-only).
SESSION_COOKIE_SECURE=0

# --- Backups ---
# How many daily database backups to keep under instance/backups/.
BACKUP_RETENTION=10

# --- Database ---
# Defaults to the bundled SQLite file at instance/school.db. For production use
# PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://posyhub:posyhub@localhost:5432/posyhub
# DATABASE_URL=sqlite:////absolute/path/to/school.db
DATABASE_URL=

# Postgres connection-pool sizing (only used when DATABASE_URL is Postgres).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# --- Environment / runtime ---
# development | production | testing. Selects config + debug behaviour.
APP_ENV=development

# Port the app/gunicorn binds to.
PORT=5000

# Gunicorn (production). Keep WEB_CONCURRENCY=1 unless background jobs are moved
# out of process — see gunicorn.conf.py.
# WEB_CONCURRENCY=1
# GUNICORN_THREADS=4

# --- Reverse proxy / security headers ---
# Set to 1 when running behind nginx so X-Forwarded-* headers are trusted.
TRUST_PROXY=0
# Security response headers are on by default; set 0 to disable.
SECURITY_HEADERS=1
# Send HSTS (only takes effect over HTTPS). Recommended once TLS is in front.
ENABLE_HSTS=0
# Optional Content-Security-Policy override (otherwise the app default is used).
# CONTENT_SECURITY_POLICY=

# --- Logging ---
LOG_LEVEL=INFO
# Optional rotating log file (in addition to stderr), e.g. instance/logs/app.log
# LOG_FILE=
