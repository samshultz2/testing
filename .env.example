# PosyHub environment configuration
# Copy this file to ".env" (same folder as app.py) and edit the values.
# Real OS environment variables override anything set here.
# NEVER commit your real .env — it's already in .gitignore.

# --- Security (set these in production) ---
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left unset, a random key is generated and stored in instance/.secret_key.
SECRET_KEY=

# Legacy shared "Admin" login. There is NO built-in password: this path is inert
# unless you BOTH enable it below AND set a strong password here. Prefer real
# user accounts and leave it disabled.
ADMIN_PASSWORD=

# Legacy shared-password login is OFF by default. Set to 1 (and set a strong
# ADMIN_PASSWORD above) only if you still rely on it.
ENABLE_LEGACY_LOGIN=0

# --- Login throttling ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --- Cookies ---
# In production this defaults to 1 (HTTPS-only session cookie). Set to 0 ONLY for
# a plain-HTTP LAN/Termux deployment, otherwise the cookie won't be sent and
# login will appear to fail.
SESSION_COOKIE_SECURE=1

# --- Backups ---
# How many daily database backups to keep under instance/backups/.
BACKUP_RETENTION=10
# See docs/BACKUPS.md for scheduling backups independently of the app
# (systemd timer / cron) and for the restore + verify procedure.

# --- Email (SMTP) ---
# Empty host/from => all email features stay disabled (the app still runs).
# Used for password-reset links, error alerts, and any notification emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@yourschool.edu
# SMTP_USE_TLS=1

# --- Error monitoring & alerts ---
# Server errors are persisted to this JSONL file (so the in-app Error Log
# survives restarts) and trimmed to ERROR_LOG_MAX lines.
# ERROR_LOG_FILE=instance/errors.jsonl
# ERROR_LOG_MAX=2000
# When set (and SMTP is configured), 500-errors email this address, throttled to
# at most once per ERROR_ALERT_MIN_INTERVAL seconds. Comma-separate for many.
# ALERT_EMAIL=ops@yourschool.edu
# ERROR_ALERT_MIN_INTERVAL=900
# Optional external error monitoring. Install sentry-sdk[flask] and set the DSN.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_ENVIRONMENT=production

# --- Automated fee reminders ---
# Opt-in. When enabled, a daily job prepares a DRAFT SMS to the active term's
# fee defaulters and bells admins to review and send it — nothing is auto-sent.
# A new draft is prepared at most once per FEE_REMINDER_INTERVAL_DAYS.
# FEE_REMINDER_ENABLED=0
# FEE_REMINDER_INTERVAL_DAYS=7

# --- Database ---
# Defaults to the bundled SQLite file at instance/school.db. For production use
# PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://posyhub:posyhub@localhost:5432/posyhub
# DATABASE_URL=sqlite:////absolute/path/to/school.db
DATABASE_URL=

# Postgres connection-pool sizing (only used when DATABASE_URL is Postgres).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# --- Environment / runtime ---
# development | production | testing. Selects config + debug behaviour.
APP_ENV=development

# Port the app/gunicorn binds to.
PORT=5000

# Gunicorn (production). Keep WEB_CONCURRENCY=1 unless background jobs are moved
# out of process — see gunicorn.conf.py.
# WEB_CONCURRENCY=1
# GUNICORN_THREADS=4

# Background jobs (scheduled messages + daily backup) run in-process by default.
# When scaling to multiple gunicorn workers, set this to 0 and run them in one
# separate process: python scripts/run_jobs.py
# RUN_INPROCESS_JOBS=1

# --- Reverse proxy / security headers ---
# Set to 1 when running behind nginx so X-Forwarded-* headers are trusted.
TRUST_PROXY=0
# Security response headers are on by default; set 0 to disable.
SECURITY_HEADERS=1
# Send HSTS (only takes effect over HTTPS). Recommended once TLS is in front.
ENABLE_HSTS=0
# Optional Content-Security-Policy override (otherwise the app default is used).
# CONTENT_SECURITY_POLICY=

# --- Public launcher (app_production.py + Cloudflare) ---
# Leave both blank for an INSTANT zero-setup demo URL (random *.trycloudflare.com).
# For a SHORT, STABLE URL on your own domain, set up a named tunnel once
# (docs/PHONE_PILOT.md) and put its name + the hostname you routed here:
# CLOUDFLARE_TUNNEL=edusyncra
# CLOUDFLARE_HOSTNAME=edusyncra.site

# --- Logging ---
LOG_LEVEL=INFO
# Optional rotating log file (in addition to stderr), e.g. instance/logs/app.log
# LOG_FILE=

# --- Encryption at rest (AES-256-GCM) ---
# When set, sensitive recoverable fields (student portal passwords) are stored
# encrypted in the database. Generate a key with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# After setting it, run: python scripts/encrypt_portal_passwords.py
# Losing this key makes those fields unrecoverable (portal passwords can be
# regenerated). Leave empty to keep the feature off.
# FIELD_ENCRYPTION_KEY=

# Optional: encrypt manual DB backups (scripts/backup_db.sh) with AES-256.
# BACKUP_ENCRYPTION_KEY=
