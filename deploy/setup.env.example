# EduSyncra one-shot VPS setup — copy to setup.env and fill in.
#   cp deploy/setup.env.example deploy/setup.env && nano deploy/setup.env
#   bash deploy/setup_vps.sh
# Everything else (secrets, DB URLs, control plane, owner school, cron) is done
# for you. Re-running is safe — it won't drop data or regenerate your secrets.

# ── Your domain ─────────────────────────────────────────────────────────────
TENANT_BASE_DOMAIN=edusyncra.site
APEX_TENANT=myschool                 # short id for your EXISTING school; it is served at the apex
OWNER_SCHOOL_NAME=My School          # display name of your existing school
OWNER_ADMIN_EMAIL=you@example.com    # owner/admin email

# ── Service / run-on-boot ───────────────────────────────────────────────────
APP_USER=                            # OS user to run the app as (blank = whoever runs the installer)
INSTALL_SERVICE=yes                  # install a systemd service so the app auto-starts on boot

# ── Cloudflare tunnel (optional; requires a one-time browser login) ──────────
SETUP_TUNNEL=no                      # yes = also install cloudflared + a named tunnel (run once, interactive)
TUNNEL_NAME=edusyncra

# ── PostgreSQL (local on the VPS) ───────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
DB_APP_USER=posyhub
DB_APP_PASSWORD=change-this-to-a-strong-password
DB_OWNER_NAME=posyhub                # database for your existing school
DB_CONTROL_NAME=edusyncra_control    # the tenant registry (created empty)

# ── Migrate your current database (optional) ────────────────────────────────
# Path to a pg_dump of your current school DB (see deploy/migrate_db.sh export).
# Leave blank to start with a fresh, empty owner school instead.
OWNER_DB_DUMP=

# ── Paystack (platform account) — use TEST keys first ───────────────────────
PLATFORM_PAYSTACK_SECRET_KEY=
PLATFORM_PAYSTACK_PUBLIC_KEY=
TENANT_PRICE_KOBO=5000000            # ₦50,000 / month (kobo)
TENANT_TERM_DAYS=120

# ── Email (school verification + billing reminders) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
